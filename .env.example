DATABASE_URL=postgresql://zhian:local-development-only@localhost:5438/zhian
JWT_SECRET=development-only-change-me-32-characters-minimum
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
NODE_ENV=development
# Optional: persistent imported question bank images; default data/question-bank/assets in this repo.
# QUESTION_BANK_ASSET_DIR=/absolute/path/to/question-bank/assets
# Optional AI bootstrap. Set another gateway from the admin AI settings page.
# AI_BASE_URL=https://relay.example.com/v1
# AI_MODEL=your-model-id
# AI_API_KEY=your-gateway-key
# AI_TOKEN_LIMIT_FIELD=max_completion_tokens
# AI_PRIVATE_GATEWAY_ORIGINS=https://relay.internal.example:8443
# Set only when intentionally creating a local administrator:
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-unique-password
