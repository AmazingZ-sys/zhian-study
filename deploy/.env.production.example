# Copy to .env.production; chmod 600. Never source this file as shell code.
IMAGE_REPO=ghcr.io/amazingz-sys/zhian-study-api
DATABASE_URL=postgresql://zhian:REPLACE_PASSWORD@database.internal:5432/zhian?sslmode=verify-full
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CORS_ORIGINS=https://study.example.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
NODE_ENV=production
PORT=3000
# Exact socket peer of host Nginx as seen inside Docker; inspect your bridge gateway.
# Never trust arbitrary public addresses or all proxies. Nginx overwrites X-Real-IP.
TRUSTED_PROXY_IPS=172.17.0.1,::ffff:172.17.0.1
# Use same-site custom domains (study.example.com / api.example.com).
# For cross-site vercel.app -> API cookies, use none; browser policy can still block them.
